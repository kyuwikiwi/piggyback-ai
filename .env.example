# Copy to .env.local and adjust. .env.local is git-ignored.

# Where the planning API lives. Read on the server only -- deliberately not
# NEXT_PUBLIC_, because every page fetches during render and nothing in the
# browser needs the backend's address.
#
#   local     http://127.0.0.1:8000
#   deployed  https://piggyon-api.onrender.com   (free instance; first request after idle is slow)
API_BASE_URL=http://127.0.0.1:8000
